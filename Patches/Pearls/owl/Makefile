# Pearls for the Befaco Lich (OWL2): builds the OWL patch with OwlProgram.
#
#   make OWLPROGRAM=<OwlProgram checkout> [TOOLROOT=<arm gcc bin dir>/]
#   make sysex      patch as a .syx file, to load from the OWL web interface
#   make load       load into RAM over USB MIDI (needs FirmwareSender)
#   make store SLOT=n   store in slot n
#   make size       sizes against the 144 kB patch limit
#   make size LDSCRIPT=<script with a larger PATCHRAM>   sizes of a patch
#                   that doesn't fit yet
#
# OwlProgram needs an arm-none-eabi-gcc no newer than 12 (its -ffreestanding
# build refuses the hosted C++ headers of gcc 13); its CI uses 10-2020-q4.
# Run "make libs" in OwlProgram once with the same toolchain.

OWLPROGRAM ?= ../../../../OwlProgram
TOOLROOT ?=
ROOT := $(abspath ..)
STAGE := $(ROOT)/build/owl-src
BUILDDIR := $(ROOT)/build/owl
# OwlProgram's owl2.ld, fixed: see owl2-pearls.ld.
LDSCRIPT ?= $(abspath owl2-pearls.ld)
OWL_ARGS = -C $(OWLPROGRAM) PLATFORM=OWL2 PATCHNAME=Pearls PATCHSOURCE=$(STAGE) \
	BUILD=$(BUILDDIR) TOOLROOT=$(TOOLROOT) LDSCRIPT=$(LDSCRIPT)

.PHONY: all stage patch sysex load store size clean
all: patch

# Always a clean build: the staged copies are new files each time.
stage:
	rm -rf $(STAGE) $(BUILDDIR)
	mkdir -p $(STAGE) $(BUILDDIR)
	cp *.hpp *.cpp *.c *.h *.inc $(STAGE)/
	cp -r $(ROOT)/engine $(STAGE)/engine
	cp -r $(ROOT)/lich $(STAGE)/lich
	cp -r $(ROOT)/third_party/eurorack/beads $(STAGE)/beads
	cp -r $(ROOT)/third_party/eurorack/stmlib $(STAGE)/stmlib
	# The DSP (pearls_dsp.cpp) is compiled here, without link time
	# optimisation and with a section per function, so that the linker
	# script can place its hot functions (owl2-pearls.ld); OwlProgram then
	# builds a .c that includes the assembly.
	$(TOOLROOT)arm-none-eabi-g++ $(DSP_FLAGS) -I$(STAGE) -S \
		-o $(STAGE)/pearls_dsp.raw.s $(STAGE)/pearls_dsp.cpp
	# (Local labels renamed: they share the including file's namespace;
	# the anonymous constants named, for the linker script.)
	sed -E -e 's/\.L([A-Za-z0-9_]+)/.LPearls\1/g' \
		-e 's/^\t\.section\t\.rodata$$/\t.section\t.rodata.pearls_dsp,"a"/' \
		$(STAGE)/pearls_dsp.raw.s > $(STAGE)/pearls_dsp.s
	rm $(STAGE)/pearls_dsp.cpp
	printf '// Generated by owl/Makefile.\n__asm__(".include \\"%s\\"\\n .text\\n");\n' \
		$(STAGE)/pearls_dsp.s > $(STAGE)/pearls_dsp_asm.c

# OwlProgram's flags for patches (compile.mk), minus -flto, plus a section per
# function.
DSP_FLAGS = -mcpu=cortex-m4 -mfloat-abi=hard -mfpu=fpv4-sp-d16 \
	-fsingle-precision-constant -mthumb -O3 -ffast-math -DNDEBUG \
	-nostdlib -nostartfiles -fno-builtin -ffreestanding -fpic -fpie \
	-mno-unaligned-access -fno-omit-frame-pointer -fdata-sections \
	-ffunction-sections -fno-rtti -fno-exceptions -std=gnu++17 \
	-DSTM32F4XX -DARM_MATH_CM4 -D__FPU_PRESENT=1 -D__FPU_USED=1U

# OwlProgram's release flags (compile.mk: CPPFLAGS ?=, so taken from the
# environment), plus PEARLS_CPPFLAGS. (-mslow-flash-data, which would avoid
# the literal pools, needs non-PIC code: OwlProgram builds with -fpic.)
PEARLS_CPPFLAGS ?=

# The hi-fi processor runs through the SRAM1 alias (engine/pearls_engine.cc):
# a first link finds the functions it reaches, the second places them at the
# start of the patch (tools/fast_sections.py), then a check.
FAST_ENTRY = pearls::ProcessFast
FAST_EXCLUDE = 'GranularProcessor<\(beads::Resolution\)[01],|SampleRateConverter|WowAndFlutter'
FAST_LDSCRIPT = $(STAGE)/owl2-pearls-fast.ld
OWL = CPPFLAGS="-O3 -ffast-math -DNDEBUG $(PEARLS_CPPFLAGS)" $(MAKE) $(OWL_ARGS)

patch sysex load store: stage
	$(OWL) patch
	TOOLROOT=$(TOOLROOT) python3 $(ROOT)/tools/fast_sections.py ld \
		$(BUILDDIR)/patch.elf $(FAST_ENTRY) --exclude $(FAST_EXCLUDE) \
		> $(STAGE)/fast_sections.ld
	sed -e '/PEARLS_FAST_SECTIONS/r $(STAGE)/fast_sections.ld' $(LDSCRIPT) \
		> $(FAST_LDSCRIPT)
	$(OWL) LDSCRIPT=$(FAST_LDSCRIPT) $(if $(SLOT),SLOT=$(SLOT)) $@
	TOOLROOT=$(TOOLROOT) python3 $(ROOT)/tools/fast_sections.py check \
		$(BUILDDIR)/patch.elf $(FAST_ENTRY) --exclude $(FAST_EXCLUDE)

size: patch
	$(TOOLROOT)arm-none-eabi-size $(BUILDDIR)/patch.elf
	@$(TOOLROOT)arm-none-eabi-nm --print-size --size-sort -C $(BUILDDIR)/patch.elf | tail -12
	@python3 -c "import os; s=os.path.getsize('$(BUILDDIR)/patch.bin'); print('patch.bin %d bytes (limit 147456): %s' % (s, 'OK' if s <= 147456 else 'TOO BIG'))"

clean:
	rm -rf $(STAGE) $(BUILDDIR)
